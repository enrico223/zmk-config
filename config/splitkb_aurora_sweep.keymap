#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define SYM  1
#define NUM  2
#define NAV  3

/* QMK: TAPPING_TERM 140 + PERMISSIVE_HOLD.
 * ZMK's "balanced" flavor is the equivalent of permissive hold.
 * QUICK_TAP_TERM 0 == quick-tap disabled, which is already ZMK's default.
 * Overriding &mt / &lt applies to every home-row mod and layer-tap below.
 */
&mt {
    flavor = "balanced";
    tapping-term-ms = <140>;
    // require-prior-idle-ms = <150>;  // optional: reduces home-row misfires
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <140>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp Q         &kp W        &kp E         &kp R        &kp T      &kp Y      &kp U         &kp I         &kp O        &kp P
&mt LSHIFT A  &mt LALT S   &mt LCTRL D   &mt LGUI F   &kp G      &kp H      &mt RGUI J    &mt RCTRL K   &mt RALT L   &mt RSHIFT SEMI
&kp Z         &kp X        &kp C         &kp V        &kp B      &kp N      &kp M         &kp COMMA     &kp DOT      &kp FSLH
                                &lt SYM TAB   &kp RET                       &kp SPACE   &lt NUM ESC
            >;
        };

        sym_layer {
            display-name = "Sym/Fn";
            bindings = <
&kp EXCL         &kp AT     &kp HASH   &kp DLLR   &kp PRCNT    &kp CARET   &kp AMPS    &kp STAR   &kp LPAR   &kp RPAR
&mt LSHIFT F1    &kp F2     &kp F3     &kp F4     &kp F5       &kp MINUS   &kp EQUAL   &kp LBKT   &kp RBKT   &kp SQT
&kp F6           &kp F7     &kp F8     &kp F9     &kp F10      &kp MINUS   &kp EQUAL   &kp LBRC   &kp RBRC   &kp BSLH
                                  &none   &none                          &kp BSPC   &lt NAV PSCRN
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&kp ESC   &none   &none   &none   &none     &none   &kp N1   &kp N2   &kp N3   &kp GRAVE
&none     &none   &none   &none   &none     &none   &kp N4   &kp N5   &kp N6   &kp SQT
&none     &none   &none   &none   &none     &none   &kp N7   &kp N8   &kp N9   &kp N0
                          &none   &none                 &none   &none
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&kp ESC    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &none    &none      &kp N1     &kp N2   &kp N3      &none
&kp CAPS   &none   &none   &none   &none     &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT   &none
&none      &none   &none   &none   &none     &none      &kp N7     &kp N8   &kp N9      &kp N0
                           &none   &none                 &none   &none
            >;
        };
    };
};
